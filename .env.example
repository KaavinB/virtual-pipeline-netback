# Copy to .env and fill in. .env is git-ignored.
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Postgres (docker-compose reads these too)
PGHOST=localhost
PGPORT=5434
PGUSER=vpv
PGPASSWORD=vpv
PGDATABASE=vpv

# Routing: public demo server by default; set to http://localhost:5001 after `make osrm-local`
OSRM_URL=https://router.project-osrm.org

# Metabase admin used by `make dashboard` (pick your own strong password)
MB_ADMIN_EMAIL=admin@vpv.local
MB_ADMIN_PASSWORD=
